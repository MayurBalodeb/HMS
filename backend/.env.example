# Copy this file to .env and fill in your local values
PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hms_db

JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://127.0.0.1:5500

# Optional: email for appointment reminders (leave blank to just log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hms.com
